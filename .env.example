# Get a free key at https://www.themoviedb.org/settings/api
# Either the "API Key" (v3) or the "API Read Access Token" (v4) works.
TMDB_API_KEY=paste_your_key_here

# Signs login tokens. Any long random string; required outside local development.
SECRET_KEY=change-me-to-a-long-random-string

# Optional
TMDB_LANGUAGE=en-US
APP_PORT=3000
API_PORT=5001
